<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- txtodod launchd user agent (design §5, ADR 0025: one per device, not one per workspace).
     Rendered by `txtodo daemon install`: {{LABEL}}, {{TXTODOD}} and {{LOGDIR}} are replaced.
     No --dir argument: true global mode opens every workspace the registry already knows about.
     Reference: launchd.plist(5) https://keith.github.io/xcode-man-pages/launchd.plist.5.html -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>{{LABEL}}</string>
    <key>ProgramArguments</key>
    <array>
        <string>{{TXTODOD}}</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <!-- Restart only after a failure (a non-zero exit or a crash): a daemon that lost the pid lock
         because another txtodod already serves exits 0 and must stay stopped, not be respawned
         forever (33 "already running" exits in launchd.err.log on 2026-09-19). ThrottleInterval
         keeps a crash loop from spinning. Ref: launchd.plist(5), KeepAlive / SuccessfulExit. -->
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>
    <key>ThrottleInterval</key>
    <integer>10</integer>
    <key>StandardOutPath</key>
    <string>{{LOGDIR}}/launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>{{LOGDIR}}/launchd.err.log</string>
</dict>
</plist>
