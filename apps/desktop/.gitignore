.DS_Store
node_modules
/build
/build-web
/.svelte-kit
/package
.env
.env.*
!.env.example
vite.config.js.timestamp-*
vite.config.ts.timestamp-*

# Playwright (tasks/desktop-playwright-tests) run artifacts — never checked in.
/test-results
/playwright-report
/blob-report
/playwright/.cache

# The browser build's Worker host (ADR 0042), generated by `npm run build:web-host` from
# crates/txtodo-web: about 3 MB of wasm, rebuilt rather than committed. Its two .d.ts files are
# committed so svelte-check (CI's desktop job) can type the Worker without building it.
/src/lib/web-host/*
!/src/lib/web-host/*.d.ts
