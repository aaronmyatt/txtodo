# Generated by Cargo
# will have compiled files and executables
/target/

# Generated by Tauri
# will have schema files for capabilities auto-completion
/gen/schemas

# Sidecar binaries (task desktop-daemon-sidecar-bundle): target-triple-suffixed txtodod builds
# staged here by .github/workflows/release.yml's build-desktop job right before `tauri build`
# picks them up via tauri.conf.json's bundle.externalBin. Regenerated per build, never committed —
# a human building locally runs `just stage-desktop-sidecar` (or the equivalent manual copy) first.
/binaries/*
!/binaries/.gitkeep
