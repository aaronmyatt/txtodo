/target
**/*.rs.bk
.DS_Store
# cargo-fuzz working dirs (crates/*/fuzz/)
**/fuzz/target
**/fuzz/corpus
**/fuzz/artifacts
**/fuzz/coverage

# Human-owned unfreeze switch for the fence (.claude/budgets.json.unfreezeSentinel)
.claude/UNFROZEN

# Per-workspace daemon runtime state (socket, pid, oplog, logs) — never source, and a `txtodod`
# run against this repo's own root (dogfooding) must not turn into an accidental commit.
.txtodo/

# Stray stderr redirect from a manual `txtodod ... > daemon.log 2>&1` dev run at the repo root —
# not the structured JSON logging under .txtodo/logs/ (already ignored above).
/daemon.log

# Nix build result symlinks (`nix build -o <name>`) — point into /nix/store, never source.
/result
/result-*

# release-engineering local smoke output (justfile's `release` recipe): cross-built binaries,
# the merged SBOM and its per-crate inputs, and cosign key material/signatures — all regenerable,
# never committed (the local cosign key pair in particular must never land in git history).
/dist/
/bom.json
/*.cdx.json
/crates/*/*.cdx.json
/apps/desktop/src-tauri/*.cdx.json
/relay/*.cdx.json
cosign.key
cosign.pub
*.bundle
*.sig

# Scratch Tailwind mockups for exploring UI variations — throwaway HTML, not part of the
# real app or its build (see apps/desktop/src/app.css's hand-rolled token system).
/apps/desktop/design-mockups/
/apps/desktop/design-mockups.zip

