#!/usr/bin/env bash
# Blocks the commit if the format check fails (same command CI's `format` step runs).
# Command comes from .claude/budgets.json so it stays in lockstep with CI and the Stop gate.
# Git hooks: https://git-scm.com/docs/githooks#_pre_commit
# Bypass in an emergency: git commit --no-verify
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

cmd=$(node -pe 'JSON.parse(require("fs").readFileSync(".claude/budgets.json")).commands.format')
echo "pre-commit: $cmd"
if ! bash -c "$cmd"; then
  echo "pre-commit: format check failed. Run \`cargo fmt --all\`, re-stage, commit again." >&2
  exit 1
fi
