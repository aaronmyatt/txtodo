#!/usr/bin/env bash
# Blocks the commit if the fast gate fails on what is staged (task fast-gate): rustfmt and
# file-length on the staged .rs files, clippy and the nextest fast profile on the staged crates,
# vitest on staged apps/desktop files. Budget: budgets.json.fastGateMs (5 s). Slow tests run in CI.
# Command comes from .claude/budgets.json so it stays in lockstep with pre-push and the Stop gate.
# Git hooks: https://git-scm.com/docs/githooks#_pre_commit
# Bypass in an emergency: git commit --no-verify
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

cmd=$(node -pe 'JSON.parse(require("fs").readFileSync(".claude/budgets.json")).commands.fast')
if ! bash -c "$cmd --staged"; then
  echo "pre-commit: fast gate failed. Fix it, re-stage, commit again." >&2
  exit 1
fi
