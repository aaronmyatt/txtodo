#!/usr/bin/env bash
# Blocks the push if the fast gate fails on what is being pushed (task fast-gate): the commits
# between the remote's sha and the pushed sha, per ref. Workspace-wide clippy and every slow test
# run in CI (.github/workflows/ci.yml), not here. Budget: budgets.json.fastGateMs (5 s).
# Command comes from .claude/budgets.json so it stays in lockstep with pre-commit and the Stop gate.
# Git hooks (stdin is "<local ref> <local sha> <remote ref> <remote sha>" per ref):
# https://git-scm.com/docs/githooks#_pre_push
# Bypass in an emergency: git push --no-verify
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

cmd=$(node -pe 'JSON.parse(require("fs").readFileSync(".claude/budgets.json")).commands.fast')
zero=$(git hash-object --stdin </dev/null | tr '0-9a-f' '0')
while read -r _local_ref local_sha _remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue # a branch delete pushes nothing to check
  base="$remote_sha"
  # A new branch, or a remote sha this clone has never fetched: diff from where it left main.
  if [ "$base" = "$zero" ] || ! git cat-file -e "$base^{commit}" 2>/dev/null; then
    base=$(git merge-base origin/main "$local_sha" 2>/dev/null || git rev-parse "$local_sha~1")
  fi
  if ! bash -c "$cmd --base $base --head $local_sha"; then
    echo "pre-push: fast gate failed. Fix it, commit, push again." >&2
    exit 1
  fi
done
