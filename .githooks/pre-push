#!/usr/bin/env bash
# Blocks the push if format or lint fails (same commands CI's `check` job runs).
# Commands come from .claude/budgets.json so they stay in lockstep with CI and the Stop gate.
# Git hooks: https://git-scm.com/docs/githooks#_pre_push
# Bypass in an emergency: git push --no-verify
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

for k in format lint; do
  cmd=$(node -pe 'JSON.parse(require("fs").readFileSync(".claude/budgets.json")).commands[process.argv[1]]' "$k")
  echo "pre-push [$k]: $cmd"
  if ! bash -c "$cmd"; then
    echo "pre-push: $k failed. Fix it, commit, push again." >&2
    exit 1
  fi
done
